---
const { pageTitle = "Aura Blog", description = "Embrace Inner Peace: Your Journey to Mental Wellness" } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={description} />
  
  <!-- Google Fonts: Sacramento, Playfair Display, Plus Jakarta Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700&family=Sacramento&display=swap" rel="stylesheet">

  <style is:global>
  :root {
    --bg-main: #e2f4f2;
    --bg-card: #ffffff;
    --bg-hero: linear-gradient(135deg, #b9e8e2 0%, #d8eff0 50%, #fde2d4 100%);
    
    /* DEEP GREEN NAVBAR VARIABLES (LIGHT THEME) */
    --bg-nav: #0d2823;
    --nav-text: #e2f4f2;
    --nav-text-active: #ffffff;
    --nav-btn-active: #184e44;
    
    --text-main: #1e3a38;
    --text-muted: #5e7e7b;
    --text-heading: #122b29;
    --logo-color: #56eead; /* High-contrast bright mint green for deep background */
    --btn-pill-bg: #bbf1e0;
    --btn-pill-text: #174238;
    --card-shadow: 0 10px 30px rgba(18, 43, 41, 0.05);
    --border-color: rgba(255, 255, 255, 0.6);
  }

  [data-theme="dark"] {
    --bg-main: #0d1b1a;
    --bg-card: #152625;
    --bg-hero: linear-gradient(135deg, #102d2a 0%, #173835 50%, #2b2220 100%);
    
    /* DEEP GREEN NAVBAR VARIABLES (DARK THEME) */
    --bg-nav: #081614;
    --nav-text: #a3c7c2;
    --nav-text-active: #ffffff;
    --nav-btn-active: #12352f;
    
    --text-main: #d3e7e4;
    --text-muted: #8aa8a4;
    --text-heading: #ffffff;
    --logo-color: #56eead;
    --btn-pill-bg: #1d4d42;
    --btn-pill-text: #bcf3e4;
    --card-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
    --border-color: rgba(255, 255, 255, 0.08);
  }
  </style>
</head>
<body>
  <slot />

  <script>
    const prefersDark = window.matchMedia('(prefers-color-scheme: dark)');
    function setTheme(theme) {
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('aura_theme', theme);
    }
    const savedTheme = localStorage.getItem('aura_theme') || (prefersDark.matches ? 'dark' : 'light');
    setTheme(savedTheme);

    document.addEventListener('DOMContentLoaded', () => {
      const themeBtn = document.getElementById('themeToggle');
      themeBtn?.addEventListener('click', () => {
        const current = document.documentElement.getAttribute('data-theme');
        setTheme(current === 'dark' ? 'light' : 'dark');
      });
    });
  </script>
</body>
</html>
