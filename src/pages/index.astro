---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('posts');
---

<BaseLayout pageTitle="Aura Blog | Your Journey to Mental Wellness">
  <style>
    .app-container { max-width: 1240px; margin: 0 auto; }

   /* Floating Navbar */
.navbar {
  background: var(--bg-nav);
  backdrop-filter: blur(16px);
  border-radius: 50px;
  padding: 0.8rem 2rem;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.2);
  margin-bottom: -2.5rem;
  position: relative;
  z-index: 10;
  border: 1px solid rgba(255, 255, 255, 0.12);
}

.logo { 
  font-family: 'Sacramento', cursive; 
  font-size: 2.2rem; 
  color: var(--logo-color); 
  font-weight: 700; 
  text-decoration: none;
}

/* FIX: Ensure horizontal layout and remove bullet points */
.nav-links { 
  display: flex !important; 
  flex-direction: row !important;
  gap: 1.5rem; 
  list-style: none !important; 
  list-style-type: none !important;
  margin: 0;
  padding: 0;
  align-items: center; 
}

.nav-link { 
  font-size: 0.9rem; 
  font-weight: 500; 
  color: var(--nav-text); 
  text-decoration: none;
  transition: color 0.2s;
}

.nav-link:hover {
  color: #ffffff;
}

.nav-link.active { 
  background: var(--nav-btn-active); 
  color: var(--nav-text-active); 
  padding: 0.45rem 1.1rem; 
  border-radius: 20px; 
}

.nav-actions { 
  display: flex; 
  align-items: center; 
  gap: 0.75rem; 
}

/* FIX: Clean up button styling and remove white frame */
.btn-join { 
  background: #f99c8d; 
  color: #ffffff; 
  padding: 0.55rem 1.25rem; 
  border-radius: 25px; 
  font-weight: 600; 
  font-size: 0.85rem; 
  border: none; 
  outline: none;
  cursor: pointer; 
  box-shadow: none;
}

.theme-btn { 
  background: transparent; 
  border: none; 
  font-size: 1.1rem; 
  cursor: pointer; 
  padding: 0.4rem; 
}

    /* Hero Banner Styling */
    .hero-banner {
      background: var(--bg-hero);
      border-radius: 32px;
      padding: 4rem 3.5rem;
      min-height: 380px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
      overflow: hidden;
      box-shadow: var(--card-shadow);
      margin-bottom: 3rem;
    }
    .hero-content { max-width: 520px; z-index: 2; }
    .hero-title { font-family: 'Playfair Display', serif; font-size: 2.8rem; font-weight: 600; color: var(--text-heading); line-height: 1.2; margin-bottom: 1rem; }
    .hero-sub { font-size: 1rem; color: var(--text-muted); margin-bottom: 1.8rem; }
    .btn-explore { background: var(--btn-pill-bg); color: var(--btn-pill-text); border: none; padding: 0.75rem 1.8rem; border-radius: 25px; font-weight: 600; font-size: 0.9rem; cursor: pointer; }
    .hero-img { max-width: 42%; height: auto; max-height: 300px; object-fit: contain; border-radius: 20px; z-index: 2; }
    .scroll-indicator { position: absolute; bottom: 1.5rem; left: 50%; transform: translateX(-50%); font-size: 0.75rem; color: var(--text-muted); text-align: center; }

    /* Layout Sections */
    .content-grid { display: grid; grid-template-columns: 2.5fr 1fr; gap: 2.5rem; }
    .section-subtitle { font-size: 0.85rem; color: var(--text-muted); text-transform: uppercase; font-weight: 600; letter-spacing: 0.5px; }
    .section-title { font-family: 'Playfair Display', serif; font-size: 1.8rem; color: var(--text-heading); font-weight: 700; margin-bottom: 1.5rem; }

    .featured-grid { 
      display: grid; 
      grid-template-columns: repeat(3, minmax(0, 260px)); 
      gap: 1.25rem; 
      justify-content: start;
    }

    .card { background: var(--bg-card); border-radius: 20px; padding: 1rem; box-shadow: var(--card-shadow); border: 1px solid var(--border-color); display: flex; flex-direction: column; width: 100%; }
    .card-img { width: 100%; height: 140px; object-fit: cover; border-radius: 14px; margin-bottom: 1rem; }
    .tag { display: inline-block; padding: 0.2rem 0.75rem; border-radius: 12px; font-size: 0.75rem; font-weight: 600; margin-bottom: 0.5rem; width: fit-content; }
    .tag-pink { background: #fde2e4; color: #e65c65; }
    .tag-teal { background: #d8f3dc; color: #2d6a4f; }
    .tag-blue { background: #e0f2fe; color: #0284c7; }
    .card-title { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--text-heading); font-weight: 700; margin-bottom: 0.5rem; line-height: 1.3; }
    .card-desc { font-size: 0.8rem; color: var(--text-muted); margin-bottom: 1rem; flex-grow: 1; }
    .card-meta { font-size: 0.75rem; color: var(--text-muted); margin-bottom: 1rem; }
    .btn-read { width: 100%; border: none; padding: 0.6rem; border-radius: 20px; font-weight: 600; font-size: 0.85rem; cursor: pointer; text-align: center; }
    .btn-green { background: #56eead; color: #05482c; }
    .btn-orange { background: #ff8c73; color: #ffffff; }
    .btn-cyan { background: #26c6da; color: #ffffff; }

    /* Sidebar - Most Popular */
    .popular-list { display: flex; flex-direction: column; gap: 0.85rem; }
    .popular-item { background: var(--bg-card); border-radius: 16px; padding: 0.75rem; display: flex; gap: 0.85rem; align-items: center; box-shadow: var(--card-shadow); border: 1px solid var(--border-color); }
    .popular-thumb { width: 64px; height: 64px; border-radius: 12px; object-fit: cover; flex-shrink: 0; }
    .popular-info h4 { font-family: 'Playfair Display', serif; font-size: 0.9rem; color: var(--text-heading); font-weight: 700; margin-bottom: 0.2rem; }
    .popular-tags { display: flex; gap: 0.35rem; align-items: center; margin-top: 0.25rem; }
    .mini-author { font-size: 0.75rem; color: var(--text-muted); }

   /* ==========================================
     MOBILE & RESPONSIVE OPTIMIZATIONS (ADD THIS)
     ========================================== */

  /* Prevents horizontal overflow on all elements */
  *, *::before, *::after {
    box-sizing: border-box;
  }

  /* Make containers fit mobile screens smoothly */
  .app-container, 
  .navbar, 
  .hero-banner, 
  .content-grid {
    width: 100%;
    max-width: 100%;
  }

  /* Responsive text sizes for Hero */
  .hero-title {
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    word-break: break-word;
  }

  /* Grid behavior on mobile screen sizes */
  .featured-grid {
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }

  /* Mobile Layout Rules (< 900px) */
  @media (max-width: 900px) {
    /* Stack side-by-side content vertically */
    .content-grid {
      grid-template-columns: 1fr;
    }

    /* Hide desktop navigation links on small screens */
    .nav-links {
      display: none;
    }

    /* Stack hero text and hero image vertically */
    .hero-banner {
      flex-direction: column;
      padding: 4rem 1.5rem 2.5rem;
      text-align: center;
    }

    .hero-img {
      width: 100%;
      max-width: 320px;
      height: auto;
      margin-top: 1rem;
    }

    .scroll-indicator {
      display: none;
    }
  }

  /* Extra small screens (< 480px) */
  @media (max-width: 480px) {
    .navbar {
      padding: 0.6rem 1rem;
      border-radius: 30px;
    }

    .logo {
      font-size: 1.8rem;
    }

    .btn-join {
      padding: 0.45rem 0.85rem;
      font-size: 0.75rem;
    }
  }
  </style>

  <div class="app-container">
    <header class="navbar">
      <a href="/Aura-blog/" class="logo">Aura Blog</a>
      <nav>
        <ul class="nav-links">
          <li><a href="#" class="nav-link active">Home</a></li>
          <li><a href="#" class="nav-link">Explore</a></li>
          <li><a href="#" class="nav-link">Stories</a></li>
          <li><a href="#" class="nav-link">Wellness</a></li>
          <li><a href="#" class="nav-link">Community</a></li>
          <li><a href="#" class="nav-link">Resources</a></li>
        </ul>
      </nav>
      <div class="nav-actions">
        <button class="theme-btn" id="themeToggle">🌓</button>
        <button class="btn-join">Join Community</button>
      </div>
    </header>

    <section class="hero-banner">
      <div class="hero-content">
        <h1 class="hero-title">Embrace Inner Peace: Your Journey to Mental Wellness</h1>
        <p class="hero-sub">Find solace, stories, and strength in every post.</p>
        <button class="btn-explore">Start Exploring</button>
      </div>

      <!-- CLEAN HERO IMAGE TAG -->
      <img 
        src="aura-hero.png" 
        alt="Hero Banner" 
        class="hero-img" 
      />

      <div class="scroll-indicator">
        Scroll Down<br />∨
      </div>
    </section>

    <div class="content-grid">
      <section>
        <span class="section-subtitle">Featured Posts</span>
        <h2 class="section-title">Discover Inspiring Stories</h2>

        <div class="featured-grid">
          {posts.map((post, index) => {
            const btnStyles = ['btn-green', 'btn-orange', 'btn-cyan'];
            const tagStyles = ['tag-pink', 'tag-teal', 'tag-blue'];
            return (
              <article class="card">
                <img class="card-img" src={post.data.thumb} alt={post.data.title} />
                <span class={`tag ${tagStyles[index % 3]}`}>{post.data.category || 'Self-Care'}</span>
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-desc">{post.data.excerpt}</p>
                <div class="card-meta">{post.data.authorName} / {post.data.date}</div>
                <a href={`/Aura-blog/posts/${post.slug}`} class={`btn-read ${btnStyles[index % 3]}`}>Read Story</a>
              </article>
            );
          })}
        </div>
      </section>
